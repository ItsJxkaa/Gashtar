FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
COPY deploy/gpu-requirements.txt /tmp/gpu-requirements.txt
RUN pip install --no-cache-dir -r /tmp/gpu-requirements.txt
COPY engine/ /app/
RUN pip install --no-cache-dir . && pip check
RUN pip install --no-cache-dir --no-deps torchvision==0.26.0 --index-url https://download.pytorch.org/whl/cu128 \
    && pip check \
    && python -c "import torch, torchvision; from transformers import Qwen3VLVideoProcessor; assert torch.__version__.startswith('2.11.0'); assert torchvision.__version__.startswith('0.26.0')"
ENV PYTHONUNBUFFERED=1 CASHGUARD_MODEL_PATH=/models/qwen35-9b CASHGUARD_4BIT=0 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
CMD ["python", "-m", "cashguard.model_server"]
